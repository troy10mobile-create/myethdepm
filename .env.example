# Sepolia only. Never commit real secrets to GitHub.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=require
PG_POOL_MAX=5

# Use TWO DIFFERENT test-only mnemonics. Keep them only in Render environment secrets.
ANONYMOUS_DEPOSIT_MNEMONIC=replace_with_anonymous_test_only_12_word_phrase
REGISTERED_DEPOSIT_MNEMONIC=replace_with_registered_test_only_12_word_phrase

# Separate treasury/collector wallets. These are private keys, not addresses.
ANONYMOUS_CENTRAL_PRIVATE_KEY=0xreplace_with_test_only_private_key
REGISTERED_CENTRAL_PRIVATE_KEY=0xreplace_with_test_only_private_key

# Public destination address receiving 79% of combined convenience + website fees.
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
GAS_CUSHION_MULTIPLIER=1.5
NODE_ENV=production
