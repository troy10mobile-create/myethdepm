# Sepolia testnet only. Do not use mainnet keys or real funds.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPOSIT_MNEMONIC=replace_with_new_test_only_12_word_phrase
CENTRAL_PRIVATE_KEY=0xreplace_with_test_only_private_key
CONFIRMATIONS=3
POLL_INTERVAL_MS=12000
GAS_CUSHION_MULTIPLIER=1.5
AUTO_WITHDRAW_TEST=1
RUN_MONITOR=1
DB_PATH=./storage/exchange.sqlite
