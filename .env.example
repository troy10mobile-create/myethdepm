# Sepolia testnet ONLY. Never put mainnet keys here.

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Anonymous temporary deposit addresses
ANONYMOUS_DEPOSIT_MNEMONIC=replace_with_12_word_test_mnemonic

# Anonymous central wallet (receives sweeps + sends withdrawals + fee forwards)
ANONYMOUS_CENTRAL_PRIVATE_KEY=0xreplace_with_test_private_key

# Registered-user permanent addresses
REGISTERED_DEPOSIT_MNEMONIC=replace_with_another_12_word_test_mnemonic

# Registered-user central wallet (future use for permanent-address deposits)
REGISTERED_CENTRAL_PRIVATE_KEY=0xreplace_with_another_test_private_key

# Wallet that receives 79% of (convenience + website) fees after successful cycle
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# Session cookie signing secret (long random string)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

CONFIRMATIONS=3
POLL_INTERVAL_MS=12000
GAS_CUSHION_MULTIPLIER=1.5
RUN_MONITOR=1
DB_PATH=./storage/exchange.sqlite
NODE_ENV=production
